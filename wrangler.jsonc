{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kyx-io-authority",
  "main": "worker/worker.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KYX_ROOM",
        "class_name": "KyxRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KyxRoom"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787",
    "BUILD_ID": "phase4-local"
  },
  "observability": {
    "enabled": true
  }
}
