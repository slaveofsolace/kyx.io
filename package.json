{
  "name": "kyx.io",
  "version": "1.0.0",
  "description": "Desktop-browser arena FPS currently shipping a truthful local Offline Practice slice.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:sim": "tsc -p tsconfig.sim-source.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"worker/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\" \"vitest.worker.config.ts\" --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract tests/contracts",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:browser": "playwright test tests/browser",
    "test:browser:g7-ui": "playwright test --config playwright.g7.config.js",
    "test:browser:install": "playwright install chromium",
    "test:multiplayer": "playwright test --config playwright.multiplayer.config.js",
    "test:authority": "vitest run tests/unit/authority tests/integration/authority --passWithNoTests",
    "test:authority-soak": "vitest run --config vitest.worker.config.ts tests/worker/authorityFullOccupancySoak.test.ts --reporter=verbose",
    "test:worker": "vitest run --config vitest.worker.config.ts --maxWorkers=1 --no-isolate",
    "dev:authority": "wrangler dev --local --port 8787",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env=\"\"",
    "validate:assets": "node tools/assets/validate-manifests.mjs",
    "validate:assets:release": "node tools/assets/validate-manifests.mjs --release",
    "verify:phase2-boundaries": "node tools/verify/phase2-boundaries.mjs",
    "check": "node tools/check.mjs",
    "check:full": "node tools/check.mjs --browser",
    "evidence:baseline": "node tools/evidence/capture-baseline.mjs",
    "evidence:manifest": "node tools/evidence/build-manifest.mjs evidence/2026-07-19/phase-0-baseline",
    "evidence:repo-state": "node tools/evidence/capture-repository-state.mjs . evidence/2026-07-19/phase-0-baseline",
    "audit:assets": "node tools/assets/audit-assets.mjs",
    "verify:truth": "node tools/verify/truth-surface.mjs",
    "verify:legacy-relay": "node tools/verify/legacy-relay-smoke.mjs",
    "verify:phase1": "npm run build && npm run verify:truth",
    "evidence:phase1": "node tools/evidence/capture-phase1-truth.mjs",
    "evidence:phase3:tapes": "node tools/evidence/capture-phase3-tapes.mjs",
    "evidence:phase3:browser": "node tools/evidence/capture-phase3-browser.mjs",
    "evidence:phase3:check": "node tools/evidence/capture-phase3-check.mjs",
    "evidence:g7-ui": "node tools/evidence/capture-g7-human-ui.mjs --base-url http://127.0.0.1:6197",
    "audit:g9": "node tools/security/audit-g9-readiness.mjs",
    "evidence:authority-soak": "node tools/evidence/capture-phase9-g8-authority-soak.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slaveofsolace/Ev.io-Legacy-Build.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic": "0.19.3",
    "@dimforge/rapier3d-deterministic-compat": "0.19.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "5.20260719.1",
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.43",
    "@types/three": "0.184.1",
    "eslint": "10.7.0",
    "playwright": "^1.61.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "^8.0.16",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
