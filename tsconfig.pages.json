{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/pages.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "cloudflare/pages-preview/functions/**/*.ts"
  ],
  "exclude": [
    "dist",
    "evidence",
    "node_modules",
    "public",
    "server",
    "tests"
  ]
}
