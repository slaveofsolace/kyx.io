# Cloudflare Workers Static Assets applies these headers to every browser asset.
# Worker-generated /health and /api responses are hardened in worker/worker.ts.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://kyx-io-authority.suhaibabdeljaber.workers.dev wss://kyx-io-authority.suhaibabdeljaber.workers.dev; worker-src 'self' blob:; manifest-src 'self'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Vite content-hashed assets are immutable between deployments.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
