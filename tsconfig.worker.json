{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/worker.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "worker/**/*.ts",
    "src/authority/**/*.ts",
    "src/net/**/*.ts",
    "src/physics/**/*.ts",
    "src/sim/**/*.ts"
  ],
  "exclude": [
    "dist",
    "evidence",
    "node_modules",
    "public",
    "server",
    "tests"
  ]
}
